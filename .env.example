# Optional. Web app URL of the deployed Apps Script (ends in /exec).
# Copy this file to .env.local, fill it in, and restart the dev server.
# Leave empty to keep scores in this browser only.
VITE_SCOREBOARD_URL=

# Optional. Use a different tab in the same Sheet, e.g. "bug" for the bug-hunt build
# (writes to the Scores-bug tab). Leave empty for the normal Scores tab.
VITE_SCOREBOARD_TAB=
